{
  "name": "zk-expense-splitter",
  "version": "1.0.0",
  "description": "A privacy-preserving zero-knowledge expense splitter built on the Midnight Network using Compact smart contracts.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compactc compile contract/src/zk_expense_splitter.compact managed",
    "build:contract": "compactc compile contract/src/zk_expense_splitter.compact managed",
    "test": "jest --testPathPattern=tests/ --forceExit",
    "test:watch": "jest --testPathPattern=tests/ --watch",
    "deploy": "ts-node src/deploy.ts",
    "build": "tsc --project tsconfig.json",
    "lint": "tsc --noEmit",
    "ci": "npm run lint && npm test"
  },
  "keywords": [
    "midnight",
    "zero-knowledge",
    "zk-proofs",
    "compact",
    "privacy",
    "expense-splitter",
    "blockchain",
    "defi"
  ],
  "author": "ZK Expense Splitter Contributors",
  "license": "MIT",
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testTimeout": 120000,
    "verbose": true
  }
}
