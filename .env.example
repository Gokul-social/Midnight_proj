# =============================================================================
# ZK Expense Splitter — Environment Template
# =============================================================================
# Copy this to .env and fill in your values.
# DO NOT commit .env — it is gitignored.
#
# cp .env.example .env
# =============================================================================

# Deployed contract address on Midnight Preprod
MIDNIGHT_CONTRACT_ADDRESS=pp1c7a6b2d657870656e736564a1044czk2025

# Target network (local | preprod | mainnet)
MIDNIGHT_NETWORK=preprod

# Proof server (local Docker)
MIDNIGHT_PROOF_SERVER_URI=http://localhost:6300

# Preprod Indexer GraphQL endpoint
MIDNIGHT_INDEXER_URI=https://indexer.preprod-01.midnight.network/api/v1/graphql

# Preprod RPC node
MIDNIGHT_NODE_URI=https://rpc.preprod-01.midnight.network

# Group identifier for this deployment
GROUP_ID=zk-expense-splitter-prod

# Wallet seed — 24-word BIP-39 mnemonic (KEEP SECRET — NEVER COMMIT)
# MIDNIGHT_WALLET_SEED="word1 word2 word3 ... word24"
