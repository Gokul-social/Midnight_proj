# =============================================================================
# ZK Expense Splitter — Environment Template
# =============================================================================
# Copy this to .env and fill in your values.
# DO NOT commit .env — it is gitignored.
# Network: Midnight PREVIEW (Stable — August 2026)
# Faucet: https://faucet.preview.midnight.network/
#
# cp .env.example .env
# =============================================================================

# Deployed contract address on Midnight Preview
MIDNIGHT_CONTRACT_ADDRESS=lo1c7a6b2d657870656e73654d2fe2b3zk2025

# Target network
MIDNIGHT_NETWORK=preview

# Proof server (local Docker)
MIDNIGHT_PROOF_SERVER_URI=http://localhost:6300

# Preview Indexer GraphQL endpoint
MIDNIGHT_INDEXER_URI=https://indexer.preview.midnight.network/api/v1/graphql

# Preview RPC node
MIDNIGHT_NODE_URI=https://rpc.preview.midnight.network

# Group identifier for this deployment
GROUP_ID=zk-expense-splitter-preview

# Wallet seed — 24-word BIP-39 mnemonic (KEEP SECRET — NEVER COMMIT)
# MIDNIGHT_WALLET_SEED="word1 word2 word3 ... word24"
