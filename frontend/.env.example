# =============================================================================
# ZK Expense Splitter — Frontend Environment Template (Vite)
# =============================================================================
# Copy this to .env and fill in your values.
# DO NOT commit .env — it is gitignored.
# ONLY VITE_* prefixed vars are exposed to the browser bundle.
#
# cp frontend/.env.example frontend/.env
# =============================================================================

# Deployed contract address — wired into all frontend modules
VITE_CONTRACT_ADDRESS=pp1c7a6b2d657870656e736564a1044czk2025

# Midnight Preprod network
VITE_NETWORK=preprod
VITE_NETWORK_LABEL=Midnight Preprod

# Indexer GraphQL endpoint (public — safe to expose)
VITE_INDEXER_URI=https://indexer.preprod-01.midnight.network/api/v1/graphql

# Proof server — local Docker container
VITE_PROOF_SERVER_URI=http://localhost:6300

# App metadata
VITE_APP_NAME=ZK Expense Splitter
VITE_APP_VERSION=1.0.0
